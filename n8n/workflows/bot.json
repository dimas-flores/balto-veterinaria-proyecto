{
  "id": "baltoBot",
  "name": "BALTO · Bot de Telegram del dueño (stock y pedidos)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false,
    "executionTimeout": 30
  },
  "tags": [],
  "nodes": [
    {
      "id": "Mensaje de Telegram",
      "name": "Mensaje de Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "baltoTelegram",
          "name": "BALTO Telegram"
        }
      },
      "webhookId": "balto-bot-webhook"
    },
    {
      "id": "Solo mi chat",
      "name": "Solo mi chat",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "m1",
              "leftValue": "={{ String($json.callback_query\n  ? ($json.callback_query.message?.chat?.type === 'private'\n    && $json.callback_query.from?.id === $json.callback_query.message?.chat?.id\n    ? $json.callback_query.from.id : '')\n  : ($json.message?.chat?.id ?? '')) }}",
              "rightValue": "__TELEGRAM_CHAT_ID__",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "Interpretar",
      "name": "Interpretar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "jsCode": "const text = $input.first().json.message?.text;\nconst input = typeof text === 'string' && text.length <= 160 ? text.trim() : '';\nconst command = input.match(/^\\/([a-z_]+)(?:@\\w+)?(?:[^\\S\\r\\n]+([^\\r\\n]+))?$/i);\nconst stock = input.match(/^stock(?:[^\\S\\r\\n]+([^\\r\\n]+))?$/i);\nconst cmd = command ? command[1].toLowerCase() : stock ? 'stock' : 'ayuda';\nconst arg = (command?.[2] || stock?.[1] || '').trim().slice(0, 60);\nreturn [{ json: { cmd, arg } }];"
      }
    },
    {
      "id": "Elegir comando",
      "name": "Elegir comando",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "stock",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.cmd }}",
                    "rightValue": "stock",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "pedidos",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "c2",
                    "leftValue": "={{ $json.cmd }}",
                    "rightValue": "pedidos",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "ayuda"
        }
      }
    },
    {
      "id": "Leer stock",
      "name": "Leer stock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        200
      ],
      "parameters": {
        "url": "http://drupal/api/vet/products",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $('Interpretar').first().json.arg }}"
            }
          ]
        },
        "options": {
          "timeout": 8000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "page",
                    "value": "={{ $pageCount }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.data.length < 50 }}",
              "limitPagesFetched": true,
              "maxRequests": 20
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "baltoDrupalApi",
          "name": "BALTO API interna"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "Leer pedidos",
      "name": "Leer pedidos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        400
      ],
      "parameters": {
        "url": "http://drupal/api/balto/pedidos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
