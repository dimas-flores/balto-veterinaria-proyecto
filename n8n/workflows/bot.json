    },
    {
      "id": "Formatear respuesta",
      "name": "Formatear respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        400
      ],
      "parameters": {
        "jsCode": "// Un solo formateador: el comando elegido decide qué respuesta armar.\nconst cmd = $('Interpretar').first().json.cmd;\nconst formats = {\n  stock: () => {\n    if ($input.all().some(({json}) => json.error || !Array.isArray(json.data))) return [{ json: { text: 'No pude consultar la tienda, intenta en un minuto' } }];\n    const threshold = __STOCK_THRESHOLD__;\n    const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n    const arg = $('Interpretar').first().json.arg;\n    const rows = $input.all().flatMap(i => Array.isArray(i.json.data) ? i.json.data : []);\n    const show = p => `• ${esc(p.name)} (${esc(p.sku)}): ${p.stock <= 0 ? '<b>agotado</b>' : esc(p.stock) + ' u.'}`;\n    let text;\n    if (arg) {\n      text = rows.length ? `📦 <b>Stock de “${esc(arg)}”</b>\\n\\n` + rows.slice(0, 20).map(show).join('\\n') : `No encontré productos con “${esc(arg)}”.`;\n    } else {\n      const low = rows.filter(p => Number.isFinite(p.stock) && p.stock <= threshold).sort((a, b) => a.stock - b.stock);\n      text = low.length ? `📦 <b>Stock bajo</b> (umbral ${threshold})\\n\\n` + low.slice(0, 30).map(show).join('\\n') : `✅ Todo en orden: ningún producto con ${threshold} o menos unidades.`;\n    }\n    return [{ json: { text } }];\n  },\n  pedidos: () => {\n    if ($input.all().some(({json}) => json.error || !Array.isArray(json.data))) return [{ json: { text: 'No pude consultar la tienda, intenta en un minuto' } }];\n    const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n    const rows = Array.isArray($input.first().json.data) ? $input.first().json.data : [];\n    const text = rows.length ? '🧾 <b>Últimos pedidos</b>\\n\\n' + rows.map(o => `#${esc(o.order_number)} · ${esc(o.placed)}\\n${esc(o.currency)} ${esc(o.total)} · ${esc(o.items)} producto(s) · ${esc(o.state)}`).join('\\n\\n') : 'Todavía no hay pedidos.';\n    return [{ json: { text } }];\n  },\n  ayuda: () => {\n    return [{ json: { text: 'Comandos:\\n/stock — productos con poco stock\\n/stock texto — stock de un producto (nombre o SKU)\\n/pedidos — últimos 5 pedidos' } }];\n  },\n};\nreturn (formats[cmd] ?? formats.ayuda)();"
      }
    },
    {
      "id": "¿Aviso revisado?",
      "name": "¿Aviso revisado?",
