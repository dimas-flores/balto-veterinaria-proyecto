          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "baltoPedidoSecret",
          "name": "BALTO secreto de pedidos"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "Responder",
      "name": "Responder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "baltoTelegram",
          "name": "BALTO Telegram"
        }
      }
    },
    {
      "id": "¿Confirmación de pago?",
      "name": "¿Confirmación de pago?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ /^confirmar_pago:[1-9][0-9]{0,15}$/.test($json.callback_query?.data ?? '') }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "Registrar pago en Drupal",
      "name": "Registrar pago en Drupal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        710,
        -140
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://drupal/api/balto/pedidos/' + $json.callback_query.data.split(':')[1] + '/confirmar-pago' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 8000,
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "baltoPedidoSecret",
          "name": "BALTO secreto de pedidos"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "Responder al botón",
      "name": "Responder al botón",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        950,
        -140
      ],
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $('Mensaje de Telegram').first().json.callback_query.id }}",
        "additionalFields": {
          "text": "={{ ['confirmed', 'already_paid'].includes($('Registrar pago en Drupal').first().json.status) ? 'Pago confirmado en la tienda.' : 'No se pudo confirmar. Revisa el pedido o vuelve a intentar.' }}"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "baltoTelegram",
          "name": "BALTO Telegram"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "¿Guardado en Drupal?",
      "name": "¿Guardado en Drupal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1180,
        -140
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ ['confirmed', 'already_paid'].includes($('Registrar pago en Drupal').first().json.status) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "Actualizar aviso de pedido",
      "name": "Actualizar aviso de pedido",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1420,
        -140
      ],
      "parameters": {
        "resource": "message",
        "operation": "editMessageText",
        "messageType": "message",
        "chatId": "__TELEGRAM_CHAT_ID__",
        "messageId": "={{ String($('Mensaje de Telegram').first().json.callback_query.message.message_id) }}",
        "text": "={{ ($('Mensaje de Telegram').first().json.callback_query.message.text ?? '').replace(/^Pago: Yape[^\\n]*$/m, 'Medio: Yape').split('\\n\\n⏳ Pendiente de pago')[0] + '\\n\\n✅ Pago confirmado' }}",
        "replyMarkup": "none",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "baltoTelegram",
          "name": "BALTO Telegram"
        }
