    {
      "id": "Preparar aviso técnico",
      "name": "Preparar aviso técnico",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        245,
        250
      ],
      "parameters": {
        "jsCode": "const event = $input.first().json;\nconst execution = event.execution || {};\nconst node = execution.lastNodeExecuted || event.trigger?.error?.node?.name || 'disparador no identificado';\nconst label = String(node).replace(/[^\\p{L}\\p{N} .¿?_-]/gu, '').slice(0, 80);\nconst id = /^\\d+$/.test(String(execution.id ?? '')) ? String(execution.id) : 'sin registro';\nconst cause = /timeout|timed out/i.test(String(execution.error?.name || '') + ' ' + String(execution.error?.message || ''))\n  ? 'Tiempo de espera agotado'\n  : 'Error de ejecución';\nreturn [{json: {text: [\n  'BALTO · Fallo del chatbot',\n  'Motivo: ' + cause,\n  'Nodo: ' + label,\n  'Ejecución: ' + id,\n].join('\\n')}}];\n"
      }
    },
    {
      "id": "Avisar fallo por Telegram",
      "name": "Avisar fallo por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
