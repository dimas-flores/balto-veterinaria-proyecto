# Solo desarrollo local. Generar secretos con: python3 scripts/init-env.py
COMPOSE_PROJECT_NAME=balto
DRUPAL_PORT=8080
N8N_PORT=5678
BIND_ADDRESS=127.0.0.1
DRUPAL_BASE_URL=http://localhost:8080
DRUPAL_TRUSTED_HOSTS=localhost,127.0.0.1,drupal
DB_NAME=balto
DB_USER=balto
DB_PASSWORD=CAMBIAR
DB_ROOT_PASSWORD=CAMBIAR
DRUPAL_HASH_SALT=CAMBIAR
DRUPAL_ADMIN_USER=admin_balto
DRUPAL_ADMIN_PASSWORD=CAMBIAR
# Dirección técnica de demostración; NO es el correo del negocio.
DRUPAL_ADMIN_EMAIL=admin@example.invalid
DRUPAL_STORE_MANAGER_USER=tienda_balto
DRUPAL_STORE_MANAGER_PASSWORD=CAMBIAR
DRUPAL_CLIENT_USER=cliente_balto
DRUPAL_CLIENT_PASSWORD=CAMBIAR
VET_API_KEY=CAMBIAR
N8N_ENCRYPTION_KEY=CAMBIAR
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
CHAT_WEBHOOK_URL=http://localhost:5678/webhook/chat
CHAT_ALLOWED_ORIGIN=http://localhost:8080
TZ=America/Lima

# Gemini: opcional, clave privada solo en el servidor.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Culqi opcional: llaves del MISMO entorno. Nunca se exportan a configuración Drupal.
BALTO_CULQI_PUBLIC_KEY=
BALTO_CULQI_SECRET_KEY=
BALTO_CULQI_ALLOW_LIVE=false

# Aviso de pedidos por Telegram (n8n)
BALTO_N8N_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STOCK_ALERT_THRESHOLD=5

# Opcional. Correo de pedido recibido. Configura un remitente verificado en Brevo.
BALTO_BREVO_API_KEY=
BALTO_BREVO_SENDER_EMAIL=

# Mercado Pago Checkout Pro de prueba. Usa el vendedor de prueba del panel.
BALTO_MERCADO_PAGO_TEST_TOKEN=
BALTO_MERCADO_PAGO_TEST_BUYER_ID=
# Secreto aleatorio de 64 caracteres hex para el webhook público de Telegram.
BALTO_TELEGRAM_WEBHOOK_SECRET=

# Acceso opcional al editor por HTTPS y dominio de webhook de Telegram.
BALTO_EDITOR_IP=
BALTO_TELEGRAM_SITE_ADDRESS=
