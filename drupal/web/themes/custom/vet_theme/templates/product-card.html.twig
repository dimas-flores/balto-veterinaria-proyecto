<article class="product-card{{ not item.available ? ' is-sold-out' : '' }}" data-sku="{{ item.sku }}"><a class="product-image-link" href="{{ item.url }}" aria-label="Ver {{ item.name }}"><div class="product-image"><img src="{{ item.card_image_url|default(item.image_url) }}" alt="{{ item.image_alt }}" width="{{ item.image_width|default(720) }}" height="{{ item.image_height|default(660) }}"{% if item.card_image_srcset %} srcset="{{ item.card_image_srcset }}" sizes="(max-width: 600px) 46vw, (max-width: 900px) 30vw, 300px"{% endif %} loading="lazy" decoding="async" />{% if not item.available %}<span class="product-status is-sold-out">{{ vet_english ? "Sold out" : "Agotado" }}</span>{% endif %}</div></a><div class="product-card-body"><span class="product-category">{{ item.category }}</span><h3><a href="{{ item.url }}">{{ item.name }}</a></h3><p class="product-species">{% for label in item.species %}{{ label }}{{ not loop.last ? ' · ' : '' }}{% endfor %}</p><div class="product-price-row"><strong>{{ item.price }}</strong><span class="stock-label{{ not item.available ? ' stock-label-empty' : '' }}">{{ item.available ? item.stock ~ ' disponibles' : 'Sin existencias' }}</span></div>{% if item.cart_form %}<div class="product-card-cart">{{ item.cart_form }}</div>{% else %}<a class="product-detail-link" href="{{ item.url }}">{{ vet_english ? "View product" : "Ver producto" }}</a>{% endif %}</div></article>
