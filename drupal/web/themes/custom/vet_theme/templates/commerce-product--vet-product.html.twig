{% set product_message = "Hola, BALTO Veterinaria. Quisiera consultar por " ~ balto_product.name ~ " (SKU: " ~ balto_product.sku ~ ")." %}
<article{{ attributes.addClass('product-detail') }} data-sku="{{ balto_product.sku }}">
  <div class="product-breadcrumb"><a href="{{ path('<front>') }}">Inicio</a><span>/</span><a href="{{ path('vet_api.catalog') }}">Tienda</a><span>/</span><span>{{ balto_product.category }}</span></div>
  <div class="product-detail-grid"><div class="product-detail-image"><img src="{{ balto_product.image_url }}" alt="{{ balto_product.image_alt }}" width="{{ balto_product.image_width|default(720) }}" height="{{ balto_product.image_height|default(660) }}" fetchpriority="high" /><span>{{ business.catalog_is_example ? 'Foto referencial · Producto de ejemplo' : 'Imagen del producto' }}</span></div>
  <div class="product-detail-copy">{{ title_prefix }}<span class="product-detail-category">{{ balto_product.category }}</span><h1>{{ balto_product.name }}</h1>{{ title_suffix }}<p class="product-sku">SKU: {{ balto_product.sku }} <span>·</span> {% for label in balto_product.species %}{{ label }}{{ not loop.last ? ' / ' : '' }}{% endfor %}</p><div class="product-detail-price"><strong>{{ balto_product.price }}</strong><span class="stock-label{{ not balto_product.available ? ' stock-label-empty' : '' }}"><span class="stock-dot"></span>{{ balto_product.available ? balto_product.stock ~ ' unidades disponibles' : 'Agotado por ahora' }}</span></div><div class="product-cart-form">{{ product.variations }}</div><p class="product-description">{{ balto_product.description }}</p>{% if business.catalog_is_example %}<p class="product-detail-demo">Precio, producto e inventario de ejemplo. Confirma la disponibilidad real con BALTO antes de una compra fuera de esta demo.</p>{% endif %}<p class="cart-stock-note">Las existencias se vuelven a validar al agregar al carrito. Agregar un producto todavía no reserva ni descuenta stock.</p><a class="text-link" href="{{ business.whatsapp_url }}?text={{ product_message|url_encode }}" target="_blank" rel="noopener noreferrer">Consultar este producto por WhatsApp</a></div></div>
  <div class="product-return"><a class="text-link" href="{{ path('vet_api.catalog') }}">← Seguir explorando la tienda</a><a class="text-link" href="{{ path('commerce_cart.page') }}">Ver mi carrito</a></div>
{% if related_products %}
  <section class="related-products" aria-labelledby="related-title">
    <h2 id="related-title">También te puede gustar</h2>
    <div class="product-grid related-product-grid">{% for item in related_products %}{% include '@vet_theme/templates/product-card.html.twig' with {item: item, vet_english: vet_english} only %}{% endfor %}</div>
  </section>
  {% endif %}
</article>
