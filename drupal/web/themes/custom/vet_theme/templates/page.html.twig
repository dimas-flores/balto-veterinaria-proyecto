{% set root = path('<front>') %}
<div class="site-shell">
  <div class="utility-bar" role="region" aria-label="{{ vet_english ? 'Location' : 'Ubicación' }}">
    <div class="container utility-inner">
      <span class="utility-place">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'pin'} only %} {{ business.city }}</span>
      <span class="utility-tagline">{{ vet_english ? "Paws of the highlands" : "Patitas de altura" }}</span>
    </div>
  </div>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand{% if vet_real_logo %} brand-real{% endif %}" href="{{ root }}" aria-label="{{ business.name }}: inicio">
        <span class="brand-symbol{% if vet_logo_crop %} brand-symbol-wolf{% endif %}"><img src="{{ vet_logo }}" width="48" height="52" alt="" /></span>
        <span><strong>BALTO<span class="brand-dot">.</span></strong><small>VETERINARIA</small></span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="{{ vet_english ? 'Open menu' : 'Abrir menú' }}">
        {% include '@vet_theme/templates/icon.html.twig' with {icon: 'menu'} only %}
      </button>
      <nav id="main-navigation" class="main-navigation" aria-label="{{ vet_english ? 'Main navigation' : 'Navegación principal' }}">
        <a href="{{ root }}"{% if is_front %} aria-current="page"{% endif %}>{{ vet_english ? 'Home' : 'Inicio' }}</a>
        <a href="{{ root }}#servicios">{{ vet_english ? 'Services' : 'Servicios' }}</a>
        <a href="{{ root }}#nosotros">{{ vet_english ? 'About us' : 'Nosotros' }}</a>
        <a href="{{ root }}#historias">{{ vet_english ? 'Stories' : 'Historias' }}</a>
        <a href="{{ root }}#ubicacion">{{ vet_english ? 'Find us' : 'Encuéntranos' }}</a>
        <a href="{{ path('vet_api.catalog') }}">{{ vet_english ? 'Shop' : 'Tienda' }}</a>
        <a class="mobile-contact" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">{{ vet_english ? 'Book via WhatsApp' : 'Separar cita por WhatsApp' }}</a>
      </nav>
      <div class="header-actions">
        <a class="account-link" href="{{ path('user.page') }}">{{ vet_english ? 'My account' : 'Mi cuenta' }}</a>
        <a class="cart-link" href="{{ path('commerce_cart.page') }}" aria-label="{{ vet_english ? 'View cart' : 'Ver carrito' }}">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'bag'} only %}<span>{{ vet_english ? 'Cart' : 'Carrito' }}</span>{{ cart_count }}</a>
        <a class="button button-small header-appointment" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">{{ vet_english ? 'Book an appointment' : 'Separar cita' }}</a>
      </div>
    </div>
  </header>
  {% if page.highlighted %}<div class="container notices">{{ page.highlighted }}</div>{% endif %}
  <main id="main-content" tabindex="-1"{% if not is_front %} class="container interior-page"{% endif %}>
    {{ page.content }}
  </main>
  <footer class="site-footer">
    <div class="container footer-top">
      <div><h2>Hablemos</h2><a href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">WhatsApp y llamadas: {{ business.whatsapp }}</a>{% if business.yape_number %}{% set yape = business.yape_number|replace({' ': ''}) %}<p>Yape: {{ yape|slice(0, 3) }} {{ yape|slice(3, 3) }} {{ yape|slice(6) }}</p>{% endif %}{% if business.email %}<a href="mailto:{{ business.email }}">{{ business.email }}</a>{% endif %}</div>
      {% if not is_home %}<div><h2>Visítanos</h2>{% for address in business.addresses %}<p>{{ address }}</p>{% endfor %}</div>{% endif %}
      <div><h2>Sigamos cerca</h2>{% if business.facebook_url %}<a href="{{ business.facebook_url }}" target="_blank" rel="noopener noreferrer">{{ business.facebook_name }} en Facebook</a>{% else %}<p>Encuéntranos en Facebook como<br /><strong>{{ business.facebook_name }}</strong>.</p>{% endif %}{% if business.instagram_url %}<a href="{{ business.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram: @{{ business.instagram_user }}</a>{% endif %}{% if business.tiktok_name %}<p>TikTok: <strong>{{ business.tiktok_name }}</strong></p>{% endif %}</div>
    </div>
    <div class="container payment-strip" role="region" aria-label="Medios de pago aceptados">
      <h2>Medios de pago</h2>
      <ul class="payment-strip-list">
        {# Solo lo que el cliente puede usar hoy; PagoEfectivo aparece solo cuando Culqi esté activo. #}
        {% for method in payment_methods|filter(method => method.available) %}
          <li class="payment-chip{% if not method.available %} payment-chip-soon{% endif %}">
            {% include '@vet_theme/templates/icon.html.twig' with {icon: method.icon} only %}
            <span class="payment-chip-text">
              <strong>{{ method.label }}</strong>
              <small>{{ method.note }}</small>
            </span>
            {% if not method.available %}<span class="payment-chip-badge">Próximamente</span>{% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
    <div class="container footer-bottom"><span>© {{ vet_year }} {{ business.name }}.</span><nav class="footer-legal" aria-label="Información legal">
      <a href="{{ path('vet_api.privacy') }}">Privacidad</a>
      <a href="{{ path('vet_api.purchase_terms') }}">Condiciones de compra</a>
      {% if vet_complaints_book_url %}<a href="{{ vet_complaints_book_url }}">Libro de Reclamaciones</a>{% endif %}
    </nav></div>
  </footer>
</div>
{% if show_action_bar %}
<nav class="mobile-action-bar" aria-label="Contacto rápido">
  <a class="mobile-action mobile-action-whatsapp" href="{{ business.appointment_url }}" target="_blank" rel="noopener noreferrer">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'whatsapp'} only %}<span>Separar cita</span></a>
  <a class="mobile-action mobile-action-call" href="{{ business.phone_url }}">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'phone'} only %}<span>Llamar</span></a>
</nav>
{% endif %}
<div class="cart-drawer" data-cart-drawer hidden>
  <div class="cart-drawer-backdrop" data-cart-close></div>
  <section class="cart-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" tabindex="-1">
    <header class="cart-drawer-header"><h2 id="cart-drawer-title">Tu carrito</h2><button type="button" class="cart-drawer-close" data-cart-close aria-label="Cerrar carrito">{% include '@vet_theme/templates/icon.html.twig' with {icon: 'close'} only %}</button></header>
    <p class="cart-drawer-status" role="status" aria-live="polite" data-cart-status></p>
    <div class="cart-drawer-body" data-cart-body></div>
    <footer class="cart-drawer-footer" data-cart-footer hidden>
      <p class="cart-drawer-subtotal"><span>Subtotal</span><strong data-cart-subtotal></strong></p>
      <a class="button cart-drawer-checkout" data-cart-checkout href="{{ path('commerce_cart.page') }}">Finalizar compra</a>
      <a class="text-link" data-cart-page href="{{ path('commerce_cart.page') }}">Ver o editar el carrito</a>
    </footer>
  </section>
</div>

{% include '@vet_theme/templates/chat-widget.html.twig' %}
